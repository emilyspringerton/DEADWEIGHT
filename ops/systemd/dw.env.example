# Copy to ~/.config/deadweight/dw.env (REQUIRED by dw-server.service and dw-bot@.service).
# systemd EnvironmentFile: comments must be on their OWN lines (an inline "# ..." becomes part of the value).
# Where the bots connect (the server, locally):
DW_HOST=127.0.0.1
# dw_server listen address (0.0.0.0 = reachable from phones once the firewall allows the port):
DW_BIND=0.0.0.0
# The Android app's default port (android/.../Config.java):
DW_PORT=6980
# Binaries live in ~/.local/opt/deadweight/bin (scripts/deploy_user.sh copies them: build/ is wiped by every build).
# S521: NOT inside the DEADWEIGHT git checkout -- a path there is subject to routine repo-hygiene
# `git checkout --`/`rm -f` cleanup, which silently truncated/deleted this exact live data all
# through one dev session before this got moved. Provision the secret files below via
# `go run ./cmd/... ` / IDUNA's config/agents.json (DEADWEIGHT-SERVER / DEADWEIGHT-BOTS agents
# already exist there with real secrets in var/agent-secrets.env) -- copy each raw secret value
# into its own file (no "export KEY=" wrapper needed, a bare secret on one line is also accepted).
DW_MATCH_LOG_DIR=/home/USER/.local/var/deadweight/matches
DW_BOT_THINK_MS=300
# S521: real IDUNA auth + match-result reporting. Leaving this as --no-auth (the old VS0-era
# default) means dw_server never configures an IDUNA client at all, so NOTHING ever gets reported
# -- game_matches/ELO/draft win-loss tracking silently stay empty forever, found live 2026-09-21
# when a real player's Draft Hub never advanced past "WINS: 0" despite real wins/losses played.
DW_SERVER_ARGS=--iduna-url http://127.0.0.1:8080 --agent-secret-file /home/USER/.config/deadweight/server.secret
DW_BOT_ARGS=--iduna-url http://127.0.0.1:8080 --agent-secret-file /home/USER/.config/deadweight/bots.secret
