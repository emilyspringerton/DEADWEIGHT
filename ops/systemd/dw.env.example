# Copy to ~/.config/deadweight/dw.env (REQUIRED by dw-server.service and dw-bot@.service).
DW_HOST=127.0.0.1
DW_PORT=7700
DW_MATCH_LOG_DIR=/home/USER/DEADWEIGHT/var/matches   # binaries are expected at ~/DEADWEIGHT/build (edit the unit files if elsewhere)
DW_BOT_THINK_MS=300
# Dev/no-IDUNA (default): no extra args. With IDUNA (S503-04 item 8), e.g.:
#   DW_SERVER_ARGS=--iduna-url http://127.0.0.1:8080 --agent-secret-file /home/USER/.config/deadweight/server.secret
#   DW_BOT_ARGS=--iduna-url http://127.0.0.1:8080 --agent-secret-file /home/USER/.config/deadweight/bots.secret
DW_SERVER_ARGS=
DW_BOT_ARGS=
