# Pin BOTH target and tool Java to 21: without this rules_android's own host-side DexFileSplitter fails to compile
# ("could not locate class file for java.lang.Record") -- a JDK selection mismatch found live in KARAMBIT.
build --java_runtime_version=remotejdk_21
build --java_language_version=21
build --tool_java_runtime_version=remotejdk_21
build --tool_java_language_version=21
